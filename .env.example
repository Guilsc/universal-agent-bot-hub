# Copy to .env locally. Never commit real credentials.
DATABASE_URL=postgres://hub:REPLACE_PASSWORD@127.0.0.1:5432/hub
# Prefer TELEGRAM_BOT_TOKEN_FILE pointing to a secret outside this repository.
TELEGRAM_BOT_TOKEN_FILE=C:/secure/telegram-token.txt
TELEGRAM_BOT_USERNAME=guilherme_local_codex_agent_bot
TELEGRAM_ALLOWED_USERS=REPLACE_NUMERIC_USER_ID
# Empty means private chats only. Set explicit numeric chat IDs to enable groups.
TELEGRAM_ALLOWED_CHATS=
TELEGRAM_MODE=polling
WORKER_ROOT=work/worker
# Optional: use a dedicated authenticated Codex home for a separate worker.
# CODEX_AUTH_HOME=C:/secure/codex-home
# CODEX_BIN=C:/path/to/codex.exe
# Optional assistant capabilities. Defaults stay read-only with web search disabled.
# CODEX_SANDBOX=workspace-write
# CODEX_WEB_SEARCH=live
# CODEX_REASONING_EFFORT=medium
# CODEX_TIMEOUT_MS=1800000
# HISTORY_TURNS=20
# TELEGRAM_PROGRESS=true
# Webhook mode: set TELEGRAM_MODE=webhook, expose via an HTTPS reverse proxy,
# and register /telegram/webhook with Telegram using the same secret_token.
# TELEGRAM_WEBHOOK_SECRET_FILE=C:/secure/telegram-webhook-secret.txt
# HOST=0.0.0.0
# PORT=3000
